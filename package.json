{
    "name": "@fr0st/f5",
    "version": "2.0.4",
    "description": "F5 is a free, open-source canvas library for JavaScript.",
    "keywords": [
        "canvas",
        "context",
        "graphics",
        "2d",
        "animation"
    ],
    "homepage": "https://github.com/elusivecodes/F5",
    "bugs": {
        "url": "https://github.com/elusivecodes/F5/issues",
        "email": "elusivecodes@gmail.com"
    },
    "main": "src/index.js",
    "type": "module",
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "src"
    ],
    "scripts": {
        "build": "npm run js-compile && npm run js-minify",
        "js-compile": "rollup --config",
        "js-lint": "eslint",
        "js-minify": "terser --compress passes=2 --mangle --source-map \"content=dist/f5.js.map,url=f5.min.js.map\" --output dist/f5.min.js dist/f5.js",
        "test": "npm run test:unit && npm run test:browser",
        "test:browser": "npm run build && playwright test --forbid-only",
        "test:headed": "npm run build && playwright test --headed",
        "test:ui": "npm run build && playwright test --ui",
        "test:unit": "playwright test --config=playwright.unit.config.js"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/elusivecodes/F5.git"
    },
    "author": "Elusive <elusivecodes@gmail.com>",
    "license": "MIT",
    "private": false,
    "devDependencies": {
        "@fr0st/eslint-config": "^3.0.1",
        "@playwright/test": "^1.58.2",
        "eslint": "^10.1.0",
        "rollup": "^4.60.0",
        "terser": "^5.46.1"
    }
}
