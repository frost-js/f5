{
    "name": "@fr0st/f5",
    "version": "2.0.4",
    "private": false,
    "description": "Lightweight 2D canvas drawing, animation, paths, shapes, and vector mathematics.",
    "keywords": [
        "canvas",
        "context",
        "graphics",
        "2d",
        "animation"
    ],
    "homepage": "https://github.com/elusivecodes/F5",
    "bugs": {
        "url": "https://github.com/elusivecodes/F5/issues",
        "email": "elusivecodes@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/elusivecodes/F5.git"
    },
    "license": "MIT",
    "author": "Elusive <elusivecodes@gmail.com>",
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/f5.esm.js",
            "default": "./dist/f5.esm.js"
        },
        "./dist/*": "./dist/*",
        "./src/*": "./src/*"
    },
    "main": "./dist/f5.esm.js",
    "jsdelivr": "./dist/f5.min.js",
    "unpkg": "./dist/f5.min.js",
    "module": "./dist/f5.esm.js",
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "src"
    ],
    "scripts": {
        "build": "vite build && vite build --mode umd",
        "lint": "eslint",
        "test": "npm run build && npm run test:unit && npm run test:browser",
        "test:browser": "playwright test --forbid-only",
        "test:coverage": "playwright test --config=playwright.coverage.config.js --forbid-only",
        "test:headed": "playwright test --forbid-only --headed",
        "test:ui": "playwright test --ui",
        "test:unit": "playwright test --config=playwright.unit.config.js --forbid-only"
    },
    "browserslist": [
        "baseline newly available"
    ],
    "devDependencies": {
        "@fr0st/eslint-config": "^6.0.1",
        "@playwright/test": "^1.64.1",
        "eslint": "^10.13.0",
        "monocart-reporter": "2.14.0",
        "vite": "^8.3.5"
    },
    "overrides": {
        "monocart-reporter": {
            "monocart-coverage-reports": "2.13.0"
        }
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "publishConfig": {
        "access": "public"
    }
}
